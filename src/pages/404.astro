---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Xee Detailing" description="This page doesn’t exist." noindex>
	<section class="container-x grid min-h-[80svh] place-items-center pt-18 text-center">
		<div class="max-w-xl">
			<p class="eyebrow">404</p>
			<h1 class="font-wide mt-6 text-4xl font-black tracking-tight sm:text-6xl">Wrong turn.</h1>
			<p class="mt-5 text-lg text-mute">We couldn’t find that page. It may have moved.</p>
			<div class="mt-10 flex flex-wrap justify-center gap-3">
				<a href="/" class="btn-primary">
					Go home
				</a>
				<a href="/#contact" class="btn-ghost">
					Get a quote
				</a>
			</div>
		</div>
	</section>
</Base>
