---
import { Picture } from 'astro:assets';
import SectionHeading from './SectionHeading.astro';
import { services } from '../data/offer';
---

<section id="services" class="py-24 md:py-32" aria-labelledby="services-heading">
	<div class="container-x">
		<SectionHeading eyebrow="Services" id="services-heading">
			Everything your paint needs, <span class="serif-accent">nothing it doesn’t.</span>
			<Fragment slot="lead">
				Every job is booked in, inspected under studio lighting and done by hand. Pick a package or
				build exactly what your car needs.
			</Fragment>
		</SectionHeading>
	</div>

	<!-- A swipeable row on phones, a grid from tablets up. -->
	<ul class="mt-14 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-4 [scrollbar-width:none] sm:container-x sm:grid sm:snap-none sm:grid-cols-2 sm:overflow-visible sm:pb-0 lg:grid-cols-3 lg:gap-5">
		{services.map((s) => (
			<li class="reveal group w-[82%] shrink-0 snap-start overflow-hidden rounded-[1.75rem] border border-line bg-ink-2 xs:w-[70%] sm:w-auto">
				<div class="overflow-hidden">
					<Picture
						src={s.photo}
						alt={s.alt}
						formats={['avif']}
						fallbackFormat="webp"
						widths={[400, 640, 900]}
						sizes="(min-width: 1024px) 400px, (min-width: 640px) 50vw, 82vw"
						class:list={[
							'aspect-[4/3] w-full object-cover transition duration-[1.2s] ease-[var(--ease-out-expo)] group-hover:scale-[1.04]',
							s.focus
						]}
					/>
				</div>
				<div class="p-6 sm:p-7">
					<h3 class="font-wide text-xl font-bold tracking-tight">{s.title}</h3>
					<p class="mt-3 leading-relaxed text-mute">{s.body}</p>
				</div>
			</li>
		))}
	</ul>
</section>
