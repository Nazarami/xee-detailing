---
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';
import { business, addressLine } from '../data/site';
import { packages } from '../data/offer';

const services = [
	...packages.map((p) => p.name),
	'Paint protection film',
	'Colour change PPF',
	'Paint correction',
	'Window tint',
	'Something else'
];

const field =
	'w-full rounded-xl border border-line bg-ink px-4 py-3.5 text-base transition outline-none placeholder:text-dim focus:border-ember aria-[invalid=true]:border-ember';
const label = 'mb-2 block text-sm font-medium text-mute';
---

<section
	id="contact"
	class="relative overflow-hidden border-t border-line bg-ink-2 py-24 md:py-32"
	aria-labelledby="contact-heading"
>
	<div class="pointer-events-none absolute -bottom-48 -left-32 size-[34rem] rounded-full bg-ember/12 blur-[160px]"></div>
	<div class="relative container-x grid gap-14 lg:grid-cols-5 lg:gap-16">
		<div class="lg:col-span-2">
			<SectionHeading eyebrow="Get a quote" id="contact-heading">
				Let’s book your car <span class="serif-accent">in.</span>
				<Fragment slot="lead">
					Call or WhatsApp Huss with the car and what you’re after. He usually replies within a few
					hours during business hours.
				</Fragment>
			</SectionHeading>

			<ul class="reveal mt-10 space-y-3">
				<li>
					<a href={`tel:${business.phoneE164}`} class="contact-row group">
						<span class="contact-icon">
							<Icon name="phone" />
						</span>
						<span>
							<span class="block text-sm text-dim">Call</span>
							{business.phone}
						</span>
					</a>
				</li>
				<li>
					<a href={business.whatsapp} target="_blank" rel="noopener" class="contact-row group">
						<span class="contact-icon">
							<Icon name="whatsapp" />
						</span>
						<span>
							<span class="block text-sm text-dim">WhatsApp</span>Message us
						</span>
					</a>
				</li>
				<li>
					<a href={`mailto:${business.email}`} class="contact-row group">
						<span class="contact-icon">
							<Icon name="mail" />
						</span>
						<span class="break-all">
							<span class="block text-sm text-dim">Email</span>
							{business.email}
						</span>
					</a>
				</li>
				<li>
					<a href={business.maps} target="_blank" rel="noopener" class="contact-row group">
						<span class="contact-icon">
							<Icon name="pin" />
						</span>
						<span>
							<span class="block text-sm text-dim">Studio · Get directions</span>
							{addressLine}
						</span>
					</a>
				</li>
			</ul>

			<dl class="reveal mt-8 grid grid-cols-[auto_1fr] gap-x-8 gap-y-2 text-sm">
				{business.hours.map((h) => (
					<>
						<dt class="text-dim">{h.days}</dt>
						<dd>{h.time}</dd>
					</>
				))}
			</dl>
		</div>

		<!-- Portfolio demo: no field has a name and nothing is posted, so no enquiry ever leaves the page. -->
		<form
			id="quote-form"
			class="reveal relative grid gap-5 self-start rounded-[2rem] border border-line bg-ink-3/60 p-6 backdrop-blur sm:grid-cols-2 sm:p-10 lg:col-span-3"
		>
			<div>
				<label for="name" class={label}>
					Name
				</label>
				<input id="name" required autocomplete="name" class={field} />
			</div>
			<div>
				<label for="phone" class={label}>
					Phone
				</label>
				<input
					id="phone"
					type="tel"
					required
					autocomplete="tel"
					placeholder="04xx xxx xxx"
					class={field}
				/>
			</div>
			<div class="sm:col-span-2">
				<label for="email" class={label}>
					Email
				</label>
				<input id="email" type="email" required autocomplete="email" class={field} />
			</div>
			<div>
				<label for="vehicle" class={label}>
					Vehicle
				</label>
				<input id="vehicle" placeholder="e.g. 2025 Porsche Macan" class={field} />
			</div>
			<div>
				<label for="service" class={label}>
					Interested in
				</label>
				<div class="relative">
					<select id="service" class:list={[field, 'appearance-none pr-10']}>
						<option value="">Not sure yet</option>
						{services.map((s) => (
							<option value={s}>{s}</option>
						))}
					</select>
					<Icon
						name="chevron"
						class="pointer-events-none absolute top-1/2 right-4 size-4 -translate-y-1/2 rotate-90 text-mute"
					/>
				</div>
			</div>
			<div class="sm:col-span-2">
				<label for="message" class={label}>
					Anything else we should know?
				</label>
				<textarea
					id="message"
					rows="4"
					placeholder="Condition of the paint, when you'd like it done, questions…"
					class:list={[field, 'resize-y']}
				></textarea>
			</div>
			<div class="flex flex-col gap-4 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-sm text-dim">
					Demo form: nothing is sent. For a real quote, call or WhatsApp {business.phone}.
				</p>
				<button type="submit" class="btn-primary shrink-0">
					Send enquiry <Icon name="arrow" class="size-4" />
				</button>
			</div>

			<div
				class="form-done absolute inset-0 hidden flex-col items-center justify-center rounded-[2rem] bg-ink-3 p-8 text-center"
				role="status"
			>
				<span class="grid size-14 place-items-center rounded-full bg-ember text-ink">
					<Icon name="check" class="size-7" />
				</span>
				<p class="font-wide mt-6 text-2xl font-black" tabindex="-1">
					Looks good. This form is a demo.
				</p>
				<p class="mt-3 max-w-sm text-mute">
					Nothing was sent. To book your car in, call or WhatsApp Huss directly.
				</p>
				<div class="mt-8 flex flex-wrap justify-center gap-3">
					<a href={`tel:${business.phoneE164}`} class="btn-primary">
						<Icon name="phone" class="size-4" /> Call {business.phone}
					</a>
					<a href={business.whatsapp} target="_blank" rel="noopener" class="btn-ghost">
						<Icon name="whatsapp" class="size-4" /> WhatsApp
					</a>
				</div>
				<button
					type="button"
					data-dismiss
					class="mt-6 text-sm text-mute underline-offset-4 hover:text-bone hover:underline"
				>
					Back to the form
				</button>
			</div>
		</form>
	</div>
</section>

<style>
	@reference "../styles/global.css";
	.contact-row {
		@apply flex items-center gap-4 rounded-2xl p-2 font-semibold transition hover:bg-bone/5;
	}
	.contact-icon {
		@apply grid size-12 shrink-0 place-items-center rounded-full border border-line transition group-hover:border-ember group-hover:bg-ember group-hover:text-ink;
	}
</style>

<script>
	// Demo only: validation runs as normal, then a confirmation explains that nothing was sent.
	const form = document.querySelector<HTMLFormElement>('#quote-form');
	const done = form?.querySelector<HTMLElement>('.form-done');
	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		done?.classList.replace('hidden', 'flex');
		done?.querySelector<HTMLElement>('[tabindex="-1"]')?.focus();
	});
	done
		?.querySelector('[data-dismiss]')
		?.addEventListener('click', () => done.classList.replace('flex', 'hidden'));
</script>
