---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import heroPhoto from '../assets/work/porsche-911-iroc-02.jpg';
import { business } from '../data/site';
---

<section class="relative isolate overflow-hidden pt-18">
	<div class="pointer-events-none absolute -top-48 -left-48 -z-10 size-[40rem] rounded-full bg-ember/15 blur-[150px]"></div>

	<div class="container-x grid items-center gap-10 py-10 sm:py-14 lg:min-h-[min(calc(100svh-4.5rem),58rem)] lg:grid-cols-12 lg:gap-12 lg:py-16">
		<div class="lg:col-span-7">
			<p class="hero-in [--d:0ms] eyebrow">NXTZEN certified · Hallam, Melbourne</p>
			<h1 class="hero-in [--d:80ms] font-wide mt-6 text-[clamp(2.5rem,7.2vw,5.75rem)] leading-[0.92] font-black tracking-[-0.035em]">
				Protection, done once.{' '}
				<span class="serif-accent block text-[1.08em] text-bone/90">Done right.</span>
			</h1>
			<p class="hero-in [--d:160ms] mt-7 max-w-xl text-lg leading-relaxed text-mute">
				Ceramic and graphene coatings, paint protection film and paint correction for cars that
				deserve more than a quick detail. No volume, no shortcuts.
			</p>
			<div class="hero-in [--d:240ms] mt-9 flex flex-wrap gap-3">
				<a href="#contact" class="btn-primary">
					Get a free quote <Icon name="arrow" class="size-4" />
				</a>
				<a href="#work" class="btn-ghost">
					See our work
				</a>
			</div>

			<dl class="hero-in [--d:320ms] mt-12 grid max-w-lg grid-cols-3 gap-4 border-t border-line pt-6">
				<div>
					<dt class="text-xs tracking-wide text-dim">Google rating</dt>
					<dd class="font-wide mt-1 flex items-center gap-1.5 text-lg font-bold">
						{business.rating}
						<Icon name="star" class="size-4 text-ember" />
					</dd>
				</div>
				<div>
					<dt class="text-xs tracking-wide text-dim">Cars protected</dt>
					<dd class="font-wide mt-1 text-lg font-bold">{business.carsProtected}</dd>
				</div>
				<div>
					<dt class="text-xs tracking-wide text-dim">Coatings</dt>
					<dd class="font-wide mt-1 text-lg font-bold">NXTZEN</dd>
				</div>
			</dl>
		</div>

		<figure class="hero-in [--d:200ms] relative lg:col-span-5">
			<div class="overflow-hidden rounded-[2rem] bg-ink-3">
				<Picture
					src={heroPhoto}
					alt="Mexico Blue 1977 Porsche 911 IROC recreation under the studio light tunnel"
					formats={['avif']}
					fallbackFormat="webp"
					widths={[480, 720, 960, 1280]}
					sizes="(min-width: 1280px) 500px, (min-width: 1024px) 40vw, 100vw"
					priority
					class="aspect-[4/5] w-full object-cover"
				/>
			</div>
			<figcaption class="absolute inset-x-4 bottom-4 flex items-center justify-between gap-3 rounded-2xl border border-bone/10 bg-ink/70 px-4 py-3 text-sm backdrop-blur-md">
				<span class="font-semibold">1977 Porsche 911 IROC recreation</span>
				<span class="shrink-0 text-xs text-mute">Premium Protection</span>
			</figcaption>
		</figure>
	</div>
</section>
